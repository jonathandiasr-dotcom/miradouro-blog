{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Aptos|Aptos Display|Aptos Narrow|Aptos Serif|Aptos Mono))/i]",
        "message": "Font not provided by the design system. Available: Aptos, Aptos Display, Aptos Narrow, Aptos Serif, Aptos Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|icon|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: title, body, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|uppercase|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, uppercase, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|gold|soft|outline)$/]",
        "message": "<Badge> tone must be one of 'blue' | 'gold' | 'soft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|disabled|fullWidth|as|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, disabled, fullWidth, as, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|outline|outline-gold|on-dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'outline' | 'outline-gold' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|hoverable|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, padding, hoverable, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|beige|outline|dark|gold)$/]",
        "message": "<Card> tone must be one of 'light' | 'beige' | 'outline' | 'dark' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|tone|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Checkbox> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpertiseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|items|tone|href|style|key|ref|className|style|children)$/]",
        "message": "<ExpertiseCard> doesn't accept that prop. Declared props: icon, title, items, tone, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpertiseCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ExpertiseCard> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|as|tone|type|placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, as, tone, type, placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Field> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Field> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|label|round|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, label, round, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:blue|gold|ghost)$/]",
        "message": "<IconButton> variant must be one of 'blue' | 'gold' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:lockup|tone|height|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: lockup, tone, height, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:principal|secondaire)$/]",
        "message": "<Logo> lockup must be one of 'principal' | 'secondaire'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:color|white|black)$/]",
        "message": "<Logo> tone must be one of 'color' | 'white' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|shape|treatment|ratio|height|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, shape, treatment, ratio, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|rounded|quarter|circle)$/]",
        "message": "<PhotoFrame> shape must be one of 'rect' | 'rounded' | 'quarter' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:bw|color)$/]",
        "message": "<PhotoFrame> treatment must be one of 'bw' | 'color'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|author|role|tone|style|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, author, role, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Quote> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|align|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, intro, align, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHeader> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|gold|on-dark)$/]",
        "message": "<StatBlock> tone must be one of 'blue' | 'gold' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|href|children|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: tone, icon, href, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|gold|on-dark)$/]",
        "message": "<TextLink> tone must be one of 'blue' | 'gold' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|color|size|rotate|opacity|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Wave> doesn't accept that prop. Declared props: shape, color, size, rotate, opacity, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:arcs|pleine)$/]",
        "message": "<Wave> shape must be one of 'arcs' | 'pleine'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|gold|beige|light|grey)$/]",
        "message": "<Wave> color must be one of 'blue' | 'gold' | 'beige' | 'light' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveBullet'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|color|size|children|style|key|ref|className|style|children)$/]",
        "message": "<WaveBullet> doesn't accept that prop. Declared props: shape, color, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveBullet'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:arcs|pleine)$/]",
        "message": "<WaveBullet> shape must be one of 'arcs' | 'pleine'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveBullet'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|gold|beige|light|grey)$/]",
        "message": "<WaveBullet> color must be one of 'blue' | 'gold' | 'beige' | 'light' | 'grey'."
      }
    ]

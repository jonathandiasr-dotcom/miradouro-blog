{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "miradouro-blog.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "miradouro-blog.vercel.app"
        }
      ],
      "destination": "https://miradouro.blog/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.svg",
      "permanent": true
    },
    {
      "source": "/articles/articles/ai-music-fr.html",
      "destination": "/articles/ai-music-fr.html",
      "permanent": true
    },
    {
      "source": "/articles/articles/ai-music-en.html",
      "destination": "/articles/ai-music-en.html",
      "permanent": true
    }
  ]
}
